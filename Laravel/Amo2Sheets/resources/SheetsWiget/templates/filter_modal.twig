<div id="amo2sheets_modal">
    {% if uuid %}
        <h2 class="ui-title ui-title--xl">Редактировать фильтр</h2>
    {% else %}
        <h2 class="ui-title ui-title--xl">Сохранить фильтр</h2>
    {% endif %}


    <form id="a2s-form_filter" style="margin-top: 1rem">
        <table class="a2s-table">
            <tbody>
            <tr>
                <td class="a2s-cell_title"><label for="a2s-filter_name">Название</label></td>
                <td>
                    <input id="a2s-filter_name" name="filter_name" class="text-input" value="{{ name }}" required>
                </td>
            </tr>

            <tr>
                <td>
                    <label for="a2s-filter_comment">Комментарий</label>
                </td>
                <td>
                    <textarea id="a2s-filter_comment" name="filter_comment" class="text-input">
                        {{ comment }}
                    </textarea>
                </td>
            </tr>
            </tbody>
        </table>

        <div class="d-flex">
            <button type="submit" class="button-input button-input_blue">Сохранить</button>
            {% if uuid %}
                <button type="button" class="button-input delete_filter" data-uuid="{{ uuid }}">
                    <span class="button-input-inner">
                        <svg class="svg-icon svg-common--trash-dims">
                            <use xlink:href="#common--trash"></use>
                        </svg>
                        <span class="button-input-inner__text">Удалить</span>
                    </span>
                </button>
            {% endif %}
        </div>
    </form>
</div>

