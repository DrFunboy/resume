<div id="amo2sheets_advanced">
    <div class="list__body-right__top">
        <div class="list__top__actions--com">
            <div class="content__top__preset">
                <h2 class="content__top__preset__caption">{{ title }}</h2>
            </div>
        </div>
        <div class="list__top__actions">
            <button class="button-input button-input_add button-input_blue" id="a2s-add_connection">
                <span class="button-input-inner__text">
                    Создать выгрузку
                </span>
            </button>
        </div>
    </div>

    <div class="a2s-tabs">
        <ul class="a2s-tabs_nav a2s-full_width">
            <li class="a2s-tabs_nav_item a2s-active" data-tab="a2s-connections">Выгрузки</li>
            <li class="a2s-tabs_nav_item" data-tab="a2s-filters">Фильтры</li>
        </ul>

        <div class="a2s-tabs_content">
            <div class="a2s-tabs_pane a2s-active" id="a2s-connections">
                <div class="list__table a2s_table">
                    <div class="list-row list-row-head">
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Фильтр</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Google Таблица</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Синхронизация</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Автор</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner-content">
                                <span>Дата создания</span>
                            </div>
                        </div>
                        <div class="cell-head list-row__cell list-row__cell-head list-row__cell-template-id">
                        </div>
                    </div>

                    {% for connection in connectionData %}
                        <div class="list-row" >
                            <div class="list-row__cell edit_connection" data-uuid="{{ connection.uuid }}">
                                <div class="content-table__item__inner">
                                    <span>
                                        <a href class="list-row__template-name__table-wrapper__name-link">
                                            {{ connection.filter_name }}
                                        </a>
                                    </span>
                                </div>
                            </div>
                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ connection.sheet_id }}</span>
                                </div>
                            </div>
                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ connection.date_sync | default('-') }}</span>
                                </div>
                            </div>
                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ connection.author_name? connection.author_name : connection.author_id }}</span>
                                </div>
                            </div>
                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ connection.created_at}}</span>
                                </div>
                            </div>

                            <div class="js-list-row__cell list-row__cell list-row__cell-id">
                                <div class="content-table__item__inner" style="overflow:visible;">
                                    <div class="list-row__cell-edit-buttons a2s-pointer a2s-sync_connection" data-uuid="{{ connection.uuid }}">
                                        <span class="button-input-inner__text">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 20v-5h-5M4 4v5h5m10.938 2A8.001 8.001 0 0 0 5.07 8m-1.008 5a8.001 8.001 0 0 0 14.868 3"></path>
                                            </svg>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>

            <div class="a2s-tabs_pane" id="a2s-filters">
                <div class="list__table a2s_table">
                    <div class="list-row list-row-head">
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Название</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Ссылка</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Комментарий</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Используется</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Автор</span>
                            </div>
                        </div>
                        <div class="list-row__cell cell-head">
                            <div class="cell-head__inner cell-head__inner-content">
                                <span>Дата создания</span>
                            </div>
                        </div>
                    </div>

                    {% for filter in filterData %}
                        <div class="list-row">
                            <div class="list-row__cell edit_filter" data-uuid="{{ filter.uuid }}">
                                <div class="content-table__item__inner">
                                    <span>
                                        <a href class="list-row__template-name__table-wrapper__name-link">
                                            {{ filter.name }}
                                        </a>
                                    </span>
                                </div>
                            </div>

                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>
                                        <a href="{{ filter.full_url }}" target="_blank" class="list-row__template-name__table-wrapper__name-link">
                                            {{ filter.pipeline_id }}
                                        </a>
                                    </span>
                                </div>
                            </div>

                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ filter.comment|length > 30 ? filter.comment|slice(0, 30) ~ '...' : filter.comment }}</span>
                                </div>
                            </div>

                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ filter.used? 'Да' : 'Нет' }}</span>
                                </div>
                            </div>

                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ filter.author_name? filter.author_name : filter.author_id }}</span>
                                </div>
                            </div>
                            <div class="list-row__cell">
                                <div class="content-table__item__inner">
                                    <span>{{ filter.created_at}}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                </div>

            </div>
        </div>
    </div>
</div>
